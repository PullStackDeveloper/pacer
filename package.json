{
  "name": "pacer",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.6.5",
      "typescript": "^7.0.2"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test && bun test scripts",
    "typecheck": "turbo run typecheck && bun --bun tsc --noEmit",
    "check": "biome check .",
    "fix": "biome check --write .",
    "ci": "biome ci . && bun run typecheck && bun run test && bun run build",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.4.2",
    "lefthook": "^2.1.15",
    "turbo": "^2.11.6",
    "typescript": "catalog:"
  }
}
